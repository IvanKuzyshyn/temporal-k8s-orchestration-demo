{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["images", "registry", "scaling", "workers", "temporalAddress"],
  "properties": {
    "images": {"type":"object","additionalProperties":false,"required":["orchestrator","worker","tag"],"properties":{
      "orchestrator":{"type":"string","minLength":1},"worker":{"type":"string","minLength":1},
      "tag":{"type":"string","pattern":"^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$","not":{"enum":["latest"]}}
    }},
    "registry":{"type":"object","additionalProperties":false,"required":["namespaceSelector"],"properties":{
      "namespaceSelector":{"type":"string","minLength":1}
    }},
    "scaling":{"type":"object","additionalProperties":false,"required":["bootstrapZero","pollingInterval","cooldownPeriod"],"properties":{
      "bootstrapZero":{"type":"boolean"},
      "pollingInterval":{"type":"integer","minimum":1},"cooldownPeriod":{"type":"integer","minimum":1}
    }},
    "temporalAddress":{"const":"temporal.temporal.svc.cluster.local:7233"},
    "workers":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","runAfter"],"properties":{
      "name":{"type":"string","maxLength":49,"pattern":"^[a-z]([-a-z0-9]*[a-z0-9])?$","not":{"const":"orchestrator"}},
      "runAfter":{"type":"string"}
    }}}
  }
}
